# Crystal Dating App Configuration

# Application URLs
NEXT_PUBLIC_APP_URL=https://your-app-domain.example.com
NEXT_PUBLIC_API_URL=https://your-app-domain.example.com/api

# Voice Transcription Service
NEXT_PUBLIC_VOICE_SERVER_URL=https://your-voice-domain.example.com:8081

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (if using direct connection)
DATABASE_URL=postgresql://user:password@host:port/database

# Vercel Configuration (for deployment)
VERCEL_URL=your-vercel-deployment-url.vercel.app

# Development Server
DEV_SERVER_PORT=3000
